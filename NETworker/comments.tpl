<li class="comment">
<div class="comment-block">
[profile]<span class="image-avatar"><img decoding="async" width="80" height="80" src="{foto}" alt="{login}" /></span>[/profile]
<div class="comment-text">
<span class="time-stamp right">{date}</span>
<strong class="user-nick">[profile]{login}[/profile]</strong>
<div class="shortcode-content">{comment}</div>
<div class="read-more-button">
[fast]<i class="fa fa-reply" aria-hidden="true"></i> Ответить[/fast]
[com-edit]<i class="fa fa-pencil" aria-hidden="true"></i> Изменить[/com-edit]
[com-del]<i class="fa fa-trash" aria-hidden="true"></i> Удалить[/com-del]
<span class="pull-right">
[rating-plus]<i class="fa fa-thumbs-up" aria-hidden="true"></i> {likes}[/rating-plus]
[rating-minus]<i class="fa fa-thumbs-down" aria-hidden="true"></i> {dislikes}[/rating-minus]
</span>
</div>
</div></div>
</li>