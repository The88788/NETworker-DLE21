<div class="ot-grid-column ot-col-1of4">
<aside class="sidebar">

<div class="widget">
<h4><span>Навигация</span></h4>
<div class="widget-content">
{catmenu}
</div></div>
    
<div class="widget">
<h4><span>Популярные статьи</span></h4>
<div class="widget-content ot-w-article-list">
{custom category="1-999" template="topnews" available="global" from="0" limit="3" order="reads"}
</div></div>

<div class="widget">
<h4><span>Облако тегов</span></h4>
<div class="tagcloud">{tags}</div>
</div>
    
<div class="widget">
<h4><span>Календарь</span></h4>
<div class="widget-content">{calendar}</div>
</div>
    
<div class="widget">
<h4><span>Комментарии</span></h4>
<div class="widget-content ot-w-comment-list">
{customcomments template="modules/lastcomments" available="global" from="0" limit="5" order="date"}
</div></div>
    
<div class="widget">
<h4><span>Опросы</span></h4>
<div class="widget-content">
{vote}
</div></div>
    
</aside>
</div>