<div class="item">
<div class="item-header item-image">
<a href="{full-link}" class="ot-image-hover"><img decoding="async" width="800" height="450" src="[xfgiven_poster][xfvalue_thumb_url_poster][/xfgiven_poster][xfnotgiven_poster]{image-1}[/xfnotgiven_poster]" loading="lazy" onerror="this.onerror=null;this.src='{THEME}/images/placeholder.svg'" alt="{title}" /></a>
</div>
<div class="item-content">
<a href="{full-link}#nw-comments-list" class="item-image-c">{comments-num}</a>
<div class="item-categies">{link-category}</div>
<h3><a href="{full-link}">{title}</a></h3>
<span class="item-meta">
<span class="item-meta-i">[profile]<i class="fa fa-user" aria-hidden="true"></i>{login}[/profile]</span>
<span class="item-meta-i"><i class="fa fa-calendar" aria-hidden="true"></i> {date=d-m-y, H:i}</span>
</span>
<p>{short-story limit="250"}</p>
</div></div>